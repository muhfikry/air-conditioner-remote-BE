                            <a href="{{ route('remote.building', { idBuilding:item.id }) }}"class="text-gray-800 fw-bold text-hover-dark fs-5 name">{{ item.name }}</a>
                            <a href="{{ route('remote.building', { idBuilding:item.id }) }}" class="text-gray-500 fw-semibold fs-6 d-block text-start ps-0 description">{{ item.description ?? '-' }}</a>   
                        </div>
                        <div class="d-flex align-items-center mt-5"> 
                          <span class="badge badge-light-success mx-1">
