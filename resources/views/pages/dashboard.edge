<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  $(document).ready(function() {
      function updateData() {
          var url = "/remote/stat";

          $.ajax({
              url: url,
              method: 'GET',
              success: function(response) {
                  var result = response.data;
                  var totalActive = 0;
                  var totalInactive = 0;

                  result.forEach(function(item) {
                      totalActive += item.activeCount;
                      totalInactive += item.inactiveCount;
                  });
                  
                  $('#building').text(result.length);
                  $('#activeCount').text(totalActive);
                  $('#inactiveCount').text(totalInactive);
              },
              error: function(xhr) {
                  console.error('Error fetching data:', xhr);
              }
          });
      }
      setInterval(updateData, 1000);
      updateData();
  });
</script>
@endsection

